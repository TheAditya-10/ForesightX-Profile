SERVICE_NAME=foresightx-profile
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8002

DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/foresightx_profile
DATA_SERVICE_URL=http://localhost:8001
REQUEST_TIMEOUT_SECONDS=8
MAX_RETRIES=2
SEED_DEMO_DATA=false

# Profile photo storage. Credentials use the standard AWS env vars:
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and optionally AWS_SESSION_TOKEN.
AWS_REGION=us-east-1
AWS_S3_BUCKET=foresightx-profile-assets
AWS_S3_AVATAR_PREFIX=avatars
AWS_S3_SIGNED_URL_EXPIRES_SECONDS=900
AVATAR_MAX_BYTES=2097152
